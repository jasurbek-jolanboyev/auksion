{
  "name": "e-uylar-platform",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/api start",
    "db:setup:local": "bash scripts/setup-local-db.sh",
    "db:migrate": "npm --workspace apps/api run migrate",
    "bot": "npm --workspace apps/api run bot"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
